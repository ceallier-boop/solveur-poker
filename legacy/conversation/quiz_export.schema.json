{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Export des questions exploitantes",
 "type": "object",
 "required": [
  "meta",
  "spots",
  "questions"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "export_version",
    "generated_at",
    "locale",
    "units",
    "thresholds_mbb",
    "counts"
   ]
  },
  "spots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "spot_id",
     "table",
     "hero_position",
     "villain_positions",
     "action_history",
     "decision_type",
     "villain_stat",
     "description_fr"
    ],
    "properties": {
     "decision_type": {
      "enum": [
       "CALL_OR_FOLD",
       "SHOVE_OR_FOLD"
      ]
     },
     "villain_stat": {
      "enum": [
       "SHOVE_PCT",
       "CALL_PCT"
      ]
     },
     "table": {
      "enum": [
       "3-handed",
       "heads-up"
      ]
     }
    }
   }
  },
  "questions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "difficulty",
     "stack_bb",
     "table",
     "spot_id",
     "hero",
     "action_history",
     "villain_stats",
     "prompt_fr",
     "options",
     "correct_option_id",
     "explanation_fr",
     "leak_code",
     "data_level",
     "content_hash"
    ],
    "properties": {
     "type": {
      "enum": [
       "ADAPTATION",
       "TRAP",
       "IDENTIFICATION"
      ]
     },
     "difficulty": {
      "enum": [
       "EASY",
       "MEDIUM",
       "TRAP"
      ]
     },
     "stack_bb": {
      "enum": [
       4,
       6,
       8,
       10,
       12
      ]
     },
     "table": {
      "enum": [
       "3-handed",
       "heads-up"
      ]
     },
     "data_level": {
      "enum": [
       "A",
       "B",
       "C"
      ]
     },
     "leak_code": {
      "enum": [
       "SHOVES_TOO_OFTEN",
       "SHOVES_TOO_RARELY",
       "CALLS_TOO_OFTEN",
       "CALLS_TOO_RARELY"
      ]
     },
     "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
       "type": "object",
       "required": [
        "id",
        "label_fr"
       ],
       "properties": {
        "id": {
         "enum": [
          "A",
          "B",
          "C",
          "D"
         ]
        }
       }
      }
     },
     "villain_stats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
       "type": "object",
       "required": [
        "villain",
        "stat",
        "observed_pct",
        "gto_pct"
       ],
       "properties": {
        "villain": {
         "enum": [
          "BTN",
          "SB",
          "BB"
         ]
        },
        "stat": {
         "enum": [
          "shove_pct",
          "call_pct"
         ]
        },
        "observed_pct": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        "gto_pct": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        }
       }
      }
     },
     "solution": {
      "type": "object",
      "required": [
       "gto_action",
       "exploit_action",
       "gain_mbb",
       "noise_threshold_mbb",
       "play_ev_vs_fold_mbb"
      ],
      "properties": {
       "gto_action": {
        "enum": [
         "CALL",
         "SHOVE",
         "FOLD"
        ]
       },
       "exploit_action": {
        "enum": [
         "CALL",
         "SHOVE",
         "FOLD"
        ]
       }
      }
     }
    }
   }
  }
 }
}