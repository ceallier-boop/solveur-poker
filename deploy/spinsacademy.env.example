# /etc/spinsacademy.env (droits 640, propriétaire root, groupe spinsacademy). Ne jamais versionner le fichier réel.
# Base de l'application, hors du dossier des versions (survit aux déploiements et retours arrière)
SPINSACADEMY_DB=/opt/spinsacademy/shared/spinsacademy.sqlite
# Jeton d'administration : 32 octets aléatoires au moins, par exemple : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Sans cette variable, l'administration est fermée (403).
SPINSACADEMY_ADMIN_TOKEN=
# Dossier des sauvegardes (tools/ops/backup.py)
SPINSACADEMY_BACKUPS=/opt/spinsacademy/shared/backups
# Ne pas définir en production : SPINSACADEMY_ALLOW_STAGING (sert des datasets non publiés)
# Limitation des requêtes (spinsacademy/ratelimit.py) : 1 = plafonds par défaut, 0 = désactivée
SPINSACADEMY_RATE_LIMIT=1
# Derrière Caddy : l'adresse du client est lue dans X-Forwarded-For (sinon tous les joueurs partagent 127.0.0.1)
SPINSACADEMY_TRUST_PROXY=1
