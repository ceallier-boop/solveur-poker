# /etc/systemd/system/spinsacademy.service
[Unit]
Description=SpinsAcademy (API et interface web)
After=network.target

[Service]
User=spinsacademy
Group=spinsacademy
EnvironmentFile=/etc/spinsacademy.env
WorkingDirectory=/opt/spinsacademy/current
ExecStart=/opt/spinsacademy/current/.venv/bin/python -m uvicorn spinsacademy.api:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/spinsacademy/shared

[Install]
WantedBy=multi-user.target
